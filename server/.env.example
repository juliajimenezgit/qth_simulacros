NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://qth:qth_dev_password@localhost:5432/qth_simulacros
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
OPENAI_API_KEY=
