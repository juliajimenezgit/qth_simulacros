NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://qth:qth_dev_password@localhost:5432/qth_simulacros
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Llamadas simultáneas al chat y reintentos ante límites por minuto (429). Baja la concurrencia si aparecen.
OPENAI_MAX_CONCURRENT_REQUESTS=4
OPENAI_MAX_RETRIES=6
# Tokens por minuto que puede usar la generación. Vacío: el 80 % del límite que OpenAI indica para la cuenta.
OPENAI_TOKENS_PER_MINUTE=
OPENAI_USAGE_LOGS=true
# Detalle completo en la terminal (cada rechazo y cada llamada a OpenAI). Por defecto, solo resúmenes.
GENERATION_VERBOSE_LOGS=false
# Preguntas que escribe cada llamada en paralelo de un intento de generación
GENERATION_PART_SIZE=4
OPENAI_USAGE_CURRENCY=USD
OPENAI_CHAT_INPUT_USD_PER_1M=0.4
OPENAI_CHAT_OUTPUT_USD_PER_1M=1.6
OPENAI_EMBEDDING_USD_PER_1M=0.02
UPLOAD_DIR=storage/pdfs
MAX_PDF_MB=40
QUESTION_SIMILARITY_THRESHOLD=0.13
# Contraseña común del equipo de prueba (npm --workspace server run seed:team).
TEAM_DEMO_PASSWORD=
AUTHORIZED_USERS=[{"name":"Admin QTH","email":"admin@qthsutan.es","password":"cambia-esto","role":"ADMIN"}]
